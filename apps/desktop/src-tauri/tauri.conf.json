{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Autometa",
  "version": "0.2.3",
  "identifier": "com.autometa.studio",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run --cwd ../web dev",
    "beforeBuildCommand": "bun run --cwd ../web build"
  },
  "app": {
    "windows": [
      {
        "title": "Autometa Simulation Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "connect-src": "'self' http://localhost:8000 http://127.0.0.1:8000 ipc: http://ipc.localhost",
        "img-src": "'self' data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "media-src": "'self' blob:",
        "worker-src": "'self' blob:",
        "object-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/autometa-backend"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDNjk4MzQxOTYzM0YzMTYKUldRVzh6T1dRWU5wZkNBYWNQY0xsSjJBdHJBTUdEcmJNc3VhQUpIVm51Y3pTakYxMWRUYkx2MGEK",
      "endpoints": [
        "https://github.com/himanshuraiml/autometa/releases/latest/download/latest.json",
        "https://raw.githubusercontent.com/himanshuraiml/autometa/main/latest.json"
      ]
    }
  }
}
